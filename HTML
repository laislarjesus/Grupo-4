                <article class="produto-card destaque" data-produto-id="6">
                    <span class="selo-destaque">MAIS VENDIDO</span>
                    <div class="produto-imagem">
                        <svg viewBox="0 0 100 100" class="icone-produto">
                            <rect x="15" y="20" width="70" height="60" rx="8" fill="#e8e8e8" stroke="#333" stroke-width="3"/>
