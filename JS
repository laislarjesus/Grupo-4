// Configuração da funcionalidade de busca
document.addEventListener('DOMContentLoaded', function() {
    const campoBusca = document.getElementById('campo-busca');
    const botaoBuscar = document.getElementById('botao-buscar');
    const linkCarrinho = document.getElementById('link-carrinho');
    
    // Inicializa o contador do carrinho
    atualizarContadorCarrinho();
    
    // Evento de clique no botão buscar
    if (botaoBuscar) {
        botaoBuscar.addEventListener('click', realizarBusca);
    }
    
    // Evento de pressionar Enter no campo de busca
    if (campoBusca) {
        campoBusca.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                realizarBusca();
            }
        });
        
        // Limpar destaques ao clicar no campo de busca
        campoBusca.addEventListener('click', limparDestaques);
    }
    
    // Navegação suave para seções
    document.querySelectorAll('.nav-link[data-nav]').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('data-nav');
            const target = document.getElementById(targetId);
            if (target) {
                target.scrollIntoView({ behavior: 'smooth' });
            }
        });
    });
    
    // Configurar link do carrinho
    if (linkCarrinho) {
        linkCarrinho.addEventListener('click', function(e) {
            e.preventDefault();
            if (carrinho.length === 0) {
                mostrarNotificacao(
                    'Carrinho Vazio',
                    'Seu carrinho está vazio. Adicione produtos para continuar.'
                );
            } else {
                let resumo = 'Resumo do Carrinho:\n\n';
                carrinho.forEach((item, index) => {
                    resumo += (index + 1) + '. ' + item.nome + ' - R$ ' + item.preco.toFixed(2) + '\n';
                });
                resumo += '\nTotal: R$ ' + calcularTotal().toFixed(2);
                mostrarNotificacao('Meu Carrinho (' + carrinho.length + ' itens)', resumo);
            }
        });
    }
});

// Função para realizar a busca de produtos
function realizarBusca() {
    const campoBusca = document.getElementById('campo-busca');
    if (!campoBusca) return;
    
    const termo = campoBusca.value.trim();
    
    if (termo === '') {
        mostrarNotificacao(
            'Busca',
            'Por favor, digite o que você procura no campo de busca.'
        );
        return;
    }
    
    // Destaca os produtos que contêm o termo
    const produtos = document.querySelectorAll('.produto-card');
    let encontrados = 0;
    let primeiroEncontrado = null;
    
    produtos.forEach(produto => {
        const nome = produto.querySelector('.produto-nome');
        const descricao = produto.querySelector('.produto-descricao');
        const beneficios = produto.querySelector('.produto-beneficios');
        
        const textoProduto = (
            (nome ? nome.textContent : '') + ' ' +
            (descricao ? descricao.textContent : '') + ' ' +
            (beneficios ? beneficios.textContent : '')
        ).toLowerCase();
        
        if (textoProduto.includes(termo.toLowerCase())) {
            produto.style.border = '4px solid var(--verde)';
            produto.style.backgroundColor = '#F0FFF0';
            encontrados++;
            
            if (!primeiroEncontrado) {
                primeiroEncontrado = produto;
            }
        } else {
            produto.style.border = '3px solid var(--cinza-medio)';
            produto.style.backgroundColor = 'var(--branco)';
        }
    });
    
    // Feedback da busca
    if (encontrados === 0) {
        mostrarNotificacao(
            'Nenhum resultado',
            'Nenhum produto encontrado para "' + termo + '".\nTente: bengala, cadeira de rodas, rampa, barra de apoio...'
        );
    } else {
        mostrarNotificacao(
            'Resultados da busca',
            'Encontramos ' + encontrados + ' produto(s) para "' + termo + '"!'
        );
        
        // Rola até o primeiro produto encontrado
        if (primeiroEncontrado) {
            setTimeout(() => {
                primeiroEncontrado.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 500);
        }
    }
}

// Função para limpar os destaques da busca
function limparDestaques() {
    const produtos = document.querySelectorAll('.produto-card');
    produtos.forEach(produto => {
        produto.style.border = '';
        produto.style.backgroundColor = '';
    });
}
