    <!-- ===== CONTEÚDO PRINCIPAL ===== -->
    <main class="main-content">
        <!-- MENSAGEM DE ACESSIBILIDADE -->
        <div class="acessibilidade-info">
            <h3>Site Adaptado para Você</h3>
            <ul class="atalhos-lista">
                <li>Letras Grandes</li>
                <li>Alto Contraste</li>
                <li>Botões Ampliados</li>
                <li>Navegação Simplificada</li>
            </ul>
        </div>

        <!-- SEÇÃO: MOBILIDADE -->
        <section id="mobilidade" class="secao-produtos">
            <h2 class="secao-titulo">Produtos para Mobilidade</h2>
            <div class="produtos-grid">
                
                <!-- Produto 1: Bengala -->
                <article class="produto-card destaque" data-produto-id="1">
                    <span class="selo-destaque">MAIS VENDIDO</span>
                    <div class="produto-imagem">
                        <svg viewBox="0 0 100 100" class="icone-produto">
                            <rect x="45" y="10" width="8" height="70" rx="4" fill="#333"/>
                            <rect x="42" y="5" width="14" height="8" rx="4" fill="#555"/>
                            <circle cx="49" cy="82" r="3" fill="#333"/>
                            <line x1="30" y1="85" x2="68" y2="85" stroke="#333" stroke-width="4" stroke-linecap="round"/>
                            <line x1="25" y1="85" x2="30" y2="85" stroke="#333" stroke-width="3" stroke-linecap="round"/>
