                            <rect x="20" y="40" width="60" height="8" rx="4" fill="#333"/>
                            <rect x="20" y="70" width="20" height="6" rx="3" fill="#333"/>
                            <rect x="60" y="70" width="20" height="6" rx="3" fill="#333"/>
