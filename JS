// ===== CARRINHO DE COMPRAS =====
let carrinho = [];

// Funcao para adicionar produto ao carrinho
function adicionarAoCarrinho(nome, preco) {
    carrinho.push({ nome: nome, preco: preco });
    
    // Atualiza o contador do carrinho
    atualizarContadorCarrinho();
    
    // Feedback visual
    mostrarNotificacao(
        'Produto adicionado com sucesso!',
        '"' + nome + '" foi adicionado ao seu carrinho.' +
        '\nValor: R$ ' + preco.toFixed(2) +
        '\nTotal no carrinho: R$ ' + calcularTotal().toFixed(2)
    );
    
    // Animacao no botao clicado
    if (event && event.target) {
        const botao = event.target;
        botao.style.transform = 'scale(0.95)';
        botao.style.backgroundColor = '#1B5E20';
        setTimeout(function() {
            botao.style.transform = 'scale(1)';
            botao.style.backgroundColor = '';
        }, 300);
    }
}

// Funcao para calcular o total do carrinho
function calcularTotal() {
    return carrinho.reduce(function(total, item) {
        return total + item.preco;
    }, 0);
}

// Funcao para atualizar o contador do carrinho na navegacao
function atualizarContadorCarrinho() {
    const linkCarrinho = document.getElementById('link-carrinho');
    if (linkCarrinho) {
        linkCarrinho.textContent = 'Meu Carrinho (' + carrinho.length + ')';
    }
}

// Funcao para mostrar notificacao na tela
function mostrarNotificacao(titulo, mensagem) {
    // Remove notificacoes anteriores
    const notificacoesAntigas = document.querySelectorAll('.notificacao');
    notificacoesAntigas.forEach(function(notif) {
        notif.remove();
    });
    
    const divNotificacao = document.createElement('div');
    divNotificacao.className = 'notificacao';
    divNotificacao.setAttribute('role', 'alert');
    divNotificacao.setAttribute('aria-live', 'polite');
    
    divNotificacao.innerHTML = '<strong>' + titulo + '</strong><br>' + mensagem.replace(/\n/g, '<br>');
    
    document.body.appendChild(divNotificacao);
    
    // Remove a notificacao apos 4 segundos
    setTimeout(function() {
        divNotificacao.style.transition = 'opacity 0.5s';
        divNotificacao.style.opacity = '0';
        setTimeout(function() {
            if (divNotificacao.parentNode) {
                divNotificacao.parentNode.removeChild(divNotificacao);
            }
        }, 500);
    }, 4000);
}

