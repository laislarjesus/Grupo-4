                    </div>
                    <h3 class="produto-nome">Bengala Ajustável Antiderrapante</h3>
                    <p class="produto-descricao">
                        Bengala leve de alumínio com altura regulável. Base tripla para maior estabilidade e segurança ao caminhar.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Altura ajustável (72cm a 94cm)</li>
                        <li>Base tripla antiderrapante</li>
                        <li>Punho ergonômico emborrachado</li>
                        <li>Suporta até 120kg</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 89,90
                        <span class="parcelamento">ou 3x de R$ 29,97 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Bengala Ajustável Antiderrapante', 89.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- Produto 2: Cadeira de Rodas -->
                <article class="produto-card" data-produto-id="2">
                    <div class="produto-imagem">
                        <svg viewBox="0 0 100 100" class="icone-produto">
                            <circle cx="50" cy="50" r="20" fill="none" stroke="#333" stroke-width="4"/>
                            <circle cx="65" cy="50" r="8" fill="none" stroke="#333" stroke-width="3"/>
                            <line x1="30" y1="50" x2="70" y2="50" stroke="#333" stroke-width="4"/>
                            <line x1="50" y1="30" x2="50" y2="70" stroke="#333" stroke-width="4"/>
