<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AcessoFácil - Produtos para seu bem-estar</title>
    
    <!-- Vinculando o arquivo CSS externo -->
    <link rel="stylesheet" href="AcessoFacil_CSS.css">
</head>
<body>
    <!-- ===== HEADER ===== -->
    <header class="header">
        <h1>AcessoFácil</h1>
        <p>Produtos para sua mobilidade, segurança e conforto</p>
    </header>

    <!-- ===== BARRA DE BUSCA ===== -->
    <div class="busca-container">
        <div class="busca-wrapper">
            <input 
                type="text" 
                class="busca-input" 
                id="campo-busca"
                placeholder="O que voce procura? Ex: bengala, cadeira de rodas..."
                aria-label="Buscar produtos"
            >
            <button class="busca-botao" id="botao-buscar" aria-label="Pesquisar">
                Buscar
            </button>
        </div>
    </div>

    <!-- ===== NAVEGAÇÃO PRINCIPAL ===== -->
    <nav class="nav-principal" aria-label="Navegacao principal">
        <a href="#mobilidade" class="nav-link" data-nav="mobilidade">
            Mobilidade
        </a>
        <a href="#seguranca" class="nav-link" data-nav="seguranca">
            Seguranca
        </a>
        <a href="#conforto" class="nav-link" data-nav="conforto">
            Conforto
        </a>
        <a href="#carrinho" class="nav-link carrinho" id="link-carrinho">
            Meu Carrinho (0)
        </a>
    </nav>

    <!-- ===== CONTEUDO PRINCIPAL ===== -->
    <main class="main-content">
        <!-- MENSAGEM DE ACESSIBILIDADE -->
        <div class="acessibilidade-info">
            <h3>Site Adaptado para Voce</h3>
            <ul class="atalhos-lista">
                <li>Letras Grandes</li>
                <li>Alto Contraste</li>
                <li>Botoes Ampliados</li>
                <li>Navegacao Simplificada</li>
            </ul>
        </div>

        <!-- ========================================== -->
        <!-- SECAO: MOBILIDADE -->
        <!-- ========================================== -->
        <section id="mobilidade" class="secao-produtos">
            <h2 class="secao-titulo">Produtos para Mobilidade</h2>
            <div class="produtos-grid">
                
                <!-- PRODUTO 1: BENGALA -->
                <article class="produto-card destaque" data-produto-id="1">
                    <span class="selo-destaque">MAIS VENDIDO</span>
                    <div class="produto-imagem">
                        <img src="imagens/bengala.jpg" 
                             alt="Bengala Ajustavel Antiderrapante - Bengala de aluminio com base tripla e punho ergonomico" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Bengala Ajustavel</strong><br>Base Tripla Antiderrapante</div>'">
                    </div>
                    <h3 class="produto-nome">Bengala Ajustavel Antiderrapante</h3>
                    <p class="produto-descricao">
                        Bengala leve de aluminio com altura regulavel. Base tripla para maior estabilidade e seguranca ao caminhar.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Altura ajustavel (72cm a 94cm)</li>
                        <li>Base tripla antiderrapante</li>
                        <li>Punho ergonomico emborrachado</li>
                        <li>Suporta ate 120kg</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 89,90
                        <span class="parcelamento">ou 3x de R$ 29,97 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Bengala Ajustavel Antiderrapante', 89.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 2: CADEIRA DE RODAS -->
                <article class="produto-card" data-produto-id="2">
                    <div class="produto-imagem">
                        <img src="imagens/cadeira-rodas.webp" 
                             alt="Cadeira de Rodas Dobravel Reforcada - Estrutura em aco com freios de estacionamento" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Cadeira de Rodas</strong><br>Dobravel e Reforcada</div>'">
                    </div>
                    <h3 class="produto-nome">Cadeira de Rodas Dobravel Reforcada</h3>
                    <p class="produto-descricao">
                        Cadeira de rodas leve e dobravel, com estrutura em aco reforcado. Ideal para uso diario e facil de transportar.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Estrutura reforcada de aco</li>
                        <li>Assento almofadado removivel</li>
                        <li>Freios de estacionamento</li>
                        <li>Suporta ate 150kg</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 799,90
                        <span class="parcelamento">ou 10x de R$ 79,99 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Cadeira de Rodas Dobravel', 799.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 3: ANDADOR -->
                <article class="produto-card" data-produto-id="3">
                    <div class="produto-imagem">
                        <img src="imagens/andador.png" 
                             alt="Andador Ortopedico Dobravel - Com cesta frontal e freios de seguranca" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Andador Ortopedico</strong><br>Dobravel com Cesta</div>'">
                    </div>
                    <h3 class="produto-nome">Andador Ortopedico Dobravel</h3>
                    <p class="produto-descricao">
                        Andador com estrutura reforcada em aluminio, freios de facil acionamento e cesta frontal para compras.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Dobravel e compacto</li>
                        <li>Freios com trava de seguranca</li>
                        <li>Cesta porta-objetos incluida</li>
                        <li>Altura regulavel</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 349,90
                        <span class="parcelamento">ou 6x de R$ 58,32 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Andador Ortopedico Dobravel', 349.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 4: RAMPA -->
                <article class="produto-card destaque" data-produto-id="4">
                    <span class="selo-destaque">RECOMENDADO</span>
                    <div class="produto-imagem">
                        <img src="imagens/rampa.jpg" 
                             alt="Rampa Portatil Antiderrapante - Superficie antiderrapante dobravel para transporte" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Rampa Portatil</strong><br>Antiderrapante Dobravel</div>'">
                    </div>
                    <h3 class="produto-nome">Rampa Portatil Antiderrapante</h3>
                    <p class="produto-descricao">
                        Rampa dobravel e leve para vencer degraus e soleiras. Superficie antiderrapante para maxima seguranca.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Superficie 100% antiderrapante</li>
                        <li>Dobravel para transporte</li>
                        <li>Suporta ate 300kg</li>
                        <li>Nao requer instalacao</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 459,90
                        <span class="parcelamento">ou 8x de R$ 57,49 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Rampa Portatil Antiderrapante', 459.90)">
                        Comprar Agora
                    </button>
                </article>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- SECAO: SEGURANCA -->
        <!-- ========================================== -->
        <section id="seguranca" class="secao-produtos">
            <h2 class="secao-titulo">Produtos de Seguranca</h2>
            <div class="produtos-grid">
                
                <!-- PRODUTO 5: BARRA DE APOIO -->
                <article class="produto-card" data-produto-id="5">
                    <div class="produto-imagem">
                        <img src="imagens/barra.png" 
                             alt="Barra de Apoio Inox para Banheiro - Kit com barras de seguranca em aco inoxidavel" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Barra de Apoio Inox</strong><br>Para Banheiro</div>'">
                    </div>
                    <h3 class="produto-nome">Barra de Apoio Inox para Banheiro</h3>
                    <p class="produto-descricao">
                        Barra de seguranca em aco inoxidavel para instalacao no box do banheiro. Superficie texturizada que nao escorrega.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Aco inox resistente a ferrugem</li>
                        <li>Superficie texturizada</li>
                        <li>Suporta ate 150kg</li>
                        <li>Parafusos e buchas inclusos</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 129,90
                        <span class="parcelamento">ou 4x de R$ 32,48 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Barra de Apoio Inox', 129.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 6: TAPETE ANTIDERRAPANTE -->
                <article class="produto-card destaque" data-produto-id="6">
                    <span class="selo-destaque">MAIS VENDIDO</span>
                    <div class="produto-imagem">
                        <img src="imagens/tapete.jpg" 
                             alt="Tapete Antiderrapante com Ventosas - Para box de banheiro com antimofo" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Tapete Antiderrapante</strong><br>Com Ventosas de Fixacao</div>'">
                    </div>
                    <h3 class="produto-nome">Tapete Antiderrapante com Ventosas</h3>
                    <p class="produto-descricao">
                        Tapete emborrachado com ventosas de alta aderencia. Ideal para box do banheiro, evitando quedas e escorregões.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Ventosas de forte fixacao</li>
                        <li>Facil de lavar</li>
                        <li>Antimofo e antibacterias</li>
                        <li>Disponivel em varios tamanhos</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 59,90
                        <span class="parcelamento">ou 2x de R$ 29,95 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Tapete Antiderrapante', 59.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 7: LUZ NOTURNA COM SENSOR -->
                <article class="produto-card" data-produto-id="7">
                    <div class="produto-imagem">
                        <img src="imagens/luz-sensor.jpg" 
                             alt="Luz Noturna com Sensor de Movimento - LED automatico para corredores" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Luz Noturna</strong><br>Com Sensor de Movimento</div>'">
                    </div>
                    <h3 class="produto-nome">Luz Noturna com Sensor de Movimento</h3>
                    <p class="produto-descricao">
                        Luz de LED automatica que acende ao detectar movimento. Ideal para corredores e banheiros durante a noite.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Sensor de movimento automatico</li>
                        <li>Baixo consumo de energia</li>
                        <li>Facil instalacao (tomada)</li>
                        <li>Luz suave que nao ofusca</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 39,90
                        <span class="parcelamento">a vista com 5% de desconto</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Luz Noturna Sensor', 39.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 8: ELEVADOR DE ASSENTO SANITARIO -->
                <article class="produto-card" data-produto-id="8">
                    <div class="produto-imagem">
                        <img src="imagens/elevador-assento.jpg" 
                             alt="Elevador de Assento Sanitario - Com bracos de apoio almofadados e ajuste universal" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Elevador de Assento</strong><br>Sanitario Almofadado</div>'">
                    </div>
                    <h3 class="produto-nome">Elevador de Assento Sanitario</h3>
                    <p class="produto-descricao">
                        Assento elevado com bracos de apoio para facilitar o sentar e levantar do vaso sanitario. Almofadado e ajustavel.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Elevacao de 10cm</li>
                        <li>Bracos almofadados</li>
                        <li>Ajuste universal</li>
                        <li>Facil de higienizar</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 189,90
                        <span class="parcelamento">ou 5x de R$ 37,98 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Elevador de Assento Sanitario', 189.90)">
                        Comprar Agora
                    </button>
                </article>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- SECAO: CONFORTO -->
        <!-- ========================================== -->
        <section id="conforto" class="secao-produtos">
            <h2 class="secao-titulo">Produtos de Conforto</h2>
            <div class="produtos-grid">
                
                <!-- PRODUTO 9: ALMOFADA VISCOELASTICA -->
                <article class="produto-card destaque" data-produto-id="9">
                    <span class="selo-destaque">LANCAMENTO</span>
                    <div class="produto-imagem">
                        <img src="imagens/almofada.webp" 
                             alt="Almofada Viscoelastica Ortopedica - Espuma de memoria com capa lavavel" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Almofada Viscoelastica</strong><br>Ortopedica Conforto</div>'">
                    </div>
                    <h3 class="produto-nome">Almofada Viscoelastica Ortopedica</h3>
                    <p class="produto-descricao">
                        Almofada com espuma que se molda ao corpo, aliviando pontos de pressao. Ideal para cadeiras de rodas e poltronas.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Espuma viscoelastica NASA</li>
                        <li>Capa lavavel e respiravel</li>
                        <li>Alivia dores nas costas</li>
                        <li>Antiderrapante na base</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 119,90
                        <span class="parcelamento">ou 3x de R$ 39,97 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Almofada Viscoelastica', 119.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 10: CADEIRA DE BANHO GIRATORIA -->
                <article class="produto-card" data-produto-id="10">
                    <div class="produto-imagem">
                        <img src="imagens/cadeira-banho.png" 
                             alt="Cadeira de Banho Giratoria 360 graus - Com ventosas e estrutura em aluminio" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Cadeira de Banho</strong><br>Giratoria 360 Graus</div>'">
                    </div>
                    <h3 class="produto-nome">Cadeira de Banho Giratoria</h3>
                    <p class="produto-descricao">
                        Cadeira para banho com assento giratorio e pes antiderrapantes. Proporciona seguranca e conforto durante o banho.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Assento giratorio 360 graus</li>
                        <li>Pes com ventosas</li>
                        <li>Estrutura em aluminio</li>
                        <li>Bracos escamoteaveis</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 279,90
                        <span class="parcelamento">ou 5x de R$ 55,98 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Cadeira de Banho Giratoria', 279.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 11: SAPATILHA ORTOPEDICA -->
                <article class="produto-card" data-produto-id="11">
                    <div class="produto-imagem">
                        <img src="imagens/sapatilha.png" 
                             alt="Sapatilha Ortopedica Antiderrapante - Fechamento em velcro e palmilha anatomica" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Sapatilha Ortopedica</strong><br>Antiderrapante Conforto</div>'">
                    </div>
                    <h3 class="produto-nome">Sapatilha Ortopedica Antiderrapante</h3>
                    <p class="produto-descricao">
                        Calcado feminino com solado de borracha antiderrapante e fechamento em velcro. Palmilha anatomica removivel.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Solado 100% antiderrapante</li>
                        <li>Fechamento facil em velcro</li>
                        <li>Palmilha anatomica</li>
                        <li>Lavavel na maquina</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 149,90
                        <span class="parcelamento">ou 3x de R$ 49,97 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Sapatilha Ortopedica', 149.90)">
                        Comprar Agora
                    </button>
                </article>

                <!-- PRODUTO 12: COLCHAO CASCA DE OVO -->
                <article class="produto-card destaque" data-produto-id="12">
                    <span class="selo-destaque">EXCLUSIVO</span>
                    <div class="produto-imagem">
                        <img src="imagens/colchao.webp" 
                             alt="Colchao Casca de Ovo Hospitalar - Prevencao de escaras com capa impermeavel" 
                             class="foto-produto"
                             loading="lazy"
                             onerror="this.parentNode.innerHTML='<div class=erro-imagem><strong>Colchao Casca de Ovo</strong><br>Hospitalar D33</div>'">
                    </div>
                    <h3 class="produto-nome">Colchao Casca de Ovo Hospitalar</h3>
                    <p class="produto-descricao">
                        Colchao especial que distribui a pressao do corpo uniformemente. Previne escaras e proporciona sono confortavel.
                    </p>
                    <ul class="produto-beneficios">
                        <li>Alta densidade D33</li>
                        <li>Capa impermeavel</li>
                        <li>Previne escaras</li>
                        <li>Facil higienizacao</li>
                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 249,90
                        <span class="parcelamento">ou 5x de R$ 49,98 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Colchao Casca de Ovo', 249.90)">
                        Comprar Agora
                    </button>
                </article>
            </div>
        </section>

        <!-- SECAO DE AJUDA -->
        <div class="ajuda-container">
            <h3>Precisa de Ajuda para Escolher?</h3>
            <p>Nossos especialistas podem ajudar voce a encontrar o produto ideal para suas necessidades.</p>
            <a href="#contato" class="botao-ajuda">Falar com um Especialista</a>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="footer">
        <div class="footer-content">
            <strong>Central de Atendimento</strong><br>
            Telefone: 0800 123 4567 (atendimento 24h)<br>
