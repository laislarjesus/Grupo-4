        <a href="#seguranca" class="nav-link" data-nav="seguranca">
            <svg class="icone-nav" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
            </svg>
            Segurança
        </a>
        <a href="#conforto" class="nav-link" data-nav="conforto">
            <svg class="icone-nav" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 13H4c-1.1 0-2 .9-2 2v6h20v-6c0-1.1-.9-2-2-2zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM20 3H4c-1.1 0-2 .9-2 2v6h20V5c0-1.1-.9-2-2-2zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
            </svg>
