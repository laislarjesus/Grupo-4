                    </ul>
                    <div class="produto-preco">
                        <span class="moeda">R$</span> 349,90
                        <span class="parcelamento">ou 6x de R$ 58,32 sem juros</span>
                    </div>
                    <button class="botao-comprar" onclick="adicionarAoCarrinho('Andador Ortopédico Dobrável', 349.90)">
                        Comprar Agora
                    </button>
