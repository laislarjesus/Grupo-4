                    <div class="produto-imagem">
                        <svg viewBox="0 0 100 100" class="icone-produto">
                            <polygon points="10,80 90,20 90,80" fill="#ddd" stroke="#333" stroke-width="3"/>
                            <line x1="20" y1="80" x2="90" y2="80" stroke="#333" stroke-width="3"/>
                            <line x1="20" y1="75" x2="85" y2="25" stroke="#333" stroke-width="2" stroke-dasharray="4,4"/>
                            <line x1="25" y1="75" x2="82" y2="30" stroke="#333" stroke-width="2" stroke-dasharray="4,4"/>
