<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AcessoFácil - Produtos para seu bem-estar</title>
    
    <!-- Vinculando o arquivo CSS externo -->
    <link rel="stylesheet" href="AcessoFacil_CSS.css">
</head>
<body>
    <!-- ===== HEADER ===== -->
    <header class="header">
        <h1>AcessoFácil</h1>
        <p>Produtos para sua mobilidade, segurança e conforto</p>
    </header>

    <!-- ===== BARRA DE BUSCA ===== -->
    <div class="busca-container">
        <div class="busca-wrapper">
            <input 
                type="text" 
                class="busca-input" 
                id="campo-busca"
                placeholder="O que você procura? Ex: bengala, cadeira de rodas..."
                aria-label="Buscar produtos"
            >
            <button class="busca-botao" id="botao-buscar" aria-label="Pesquisar">
                Buscar
            </button>
        </div>
    </div>

    <!-- ===== NAVEGAÇÃO PRINCIPAL ===== -->
    <nav class="nav-principal" aria-label="Navegação principal">
        <a href="#mobilidade" class="nav-link" data-nav="mobilidade">
            <svg class="icone-nav" viewBox="0 0 24 24" fill="currentColor">
